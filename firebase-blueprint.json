{
  "entities": {
    "Member": {
      "title": "Member",
      "description": "A church member profile.",
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "Full name of the member." },
        "birthday": { "type": "string", "format": "date", "description": "Birthday in YYYY-MM-DD format." },
        "phoneNumber": { "type": "string", "description": "Contact phone number." },
        "notes": { "type": "string", "description": "Additional notes about the member." },
        "uid": { "type": "string", "description": "Firebase Auth UID if they are a registered user." }
      },
      "required": ["name", "birthday"]
    },
    "Sermon": {
      "title": "Sermon",
      "description": "A downloadable sermon PDF.",
      "type": "object",
      "properties": {
        "title": { "type": "string", "description": "Title of the sermon." },
        "preacher": { "type": "string", "description": "The preacher or author." },
        "fileUrl": { "type": "string", "description": "URL to the sermon file." },
        "fileName": { "type": "string", "description": "Name of the file in storage." },
        "uploadedAt": { "type": "string", "format": "date-time", "description": "Timestamp of upload." },
        "uploadedBy": { "type": "string", "description": "Email of the uploader." }
      },
      "required": ["title", "preacher", "fileUrl", "fileName", "uploadedAt"]
    },
    "Setting": {
      "title": "Setting",
      "description": "Global application setting or metadata document.",
      "type": "object",
      "properties": {
        "verse": { "type": "string", "description": "Text of the key verse." },
        "reference": { "type": "string", "description": "The bible reference." },
        "updatedAt": { "type": "string", "format": "date-time", "description": "When setting was updated." },
        "updatedBy": { "type": "string", "description": "Email of the editor." }
      }
    },
    "Devotion": {
      "title": "Devotion",
      "description": "A daily devotion text.",
      "type": "object",
      "properties": {
        "text": { "type": "string", "description": "The devotion content." },
        "date": { "type": "string", "format": "date", "description": "The date for this devotion." }
      },
      "required": ["text", "date"]
    },
    "Verse": {
      "title": "Verse",
      "description": "A Bible verse of the month.",
      "type": "object",
      "properties": {
        "text": { "type": "string", "description": "The verse text." },
        "reference": { "type": "string", "description": "The Bible reference (e.g., John 3:16)." },
        "month": { "type": "string", "description": "The month and year (e.g., March 2026)." }
      },
      "required": ["text", "reference", "month"]
    },
    "Event": {
      "title": "Event",
      "description": "A planned church event.",
      "type": "object",
      "properties": {
        "title": { "type": "string", "description": "Title of the event." },
        "date": { "type": "string", "format": "date", "description": "Date of the event." },
        "description": { "type": "string", "description": "Details about the event." },
        "location": { "type": "string", "description": "Where the event is held." }
      },
      "required": ["title", "date"]
    },
    "Article": {
      "title": "Article",
      "description": "A blog article written by a member.",
      "type": "object",
      "properties": {
        "title": { "type": "string", "description": "The article's title." },
        "content": { "type": "string", "description": "Full content markdown/text." },
        "authorName": { "type": "string", "description": "Display name of author." },
        "authorPhoto": { "type": "string", "description": "Google photo URL of author." },
        "authorEmail": { "type": "string", "description": "Email address of author." },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation timestamp." },
        "commentCount": { "type": "integer", "description": "Number of comments." },
        "reactions": {
          "type": "object",
          "properties": {
            "heart": { "type": "integer" },
            "thumbsUp": { "type": "integer" }
          }
        }
      },
      "required": ["title", "content", "authorName", "createdAt"]
    },
    "Comment": {
      "title": "Comment",
      "description": "A comment on a blog article.",
      "type": "object",
      "properties": {
        "text": { "type": "string", "description": "Content of the comment." },
        "authorName": { "type": "string", "description": "Author display name." },
        "authorPhoto": { "type": "string", "description": "Author photo URL." },
        "authorEmail": { "type": "string", "description": "Author email address." },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation timestamp." }
      },
      "required": ["text", "authorName", "createdAt"]
    },
    "Reaction": {
      "title": "Reaction",
      "description": "A member's reaction to an article.",
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["heart", "thumbsUp"], "description": "The reaction type." },
        "reactedAt": { "type": "string", "format": "date-time", "description": "Timestamp of reaction." }
      },
      "required": ["type", "reactedAt"]
    }
  },
  "firestore": {
    "/members/{memberId}": {
      "schema": "Member",
      "description": "Collection of church members."
    },
    "/sermons/{sermonId}": {
      "schema": "Sermon",
      "description": "Collection of sermon PDFs."
    },
    "/devotions/{devotionId}": {
      "schema": "Devotion",
      "description": "Collection of daily devotions."
    },
    "/verses/{verseId}": {
      "schema": "Verse",
      "description": "Collection of monthly verses."
    },
    "/settings/{settingId}": {
      "schema": "Setting",
      "description": "Collection of global setting/metadata documents."
    },
    "/events/{eventId}": {
      "schema": "Event",
      "description": "Collection of church events."
    },
    "/articles/{articleId}": {
      "schema": "Article",
      "description": "Collection of blog articles written by members."
    },
    "/articles/{articleId}/comments/{commentId}": {
      "schema": "Comment",
      "description": "Subcollection of comments on a specific article."
    },
    "/articles/{articleId}/reactions/{userId}": {
      "schema": "Reaction",
      "description": "Subcollection tracking individual member's reaction."
    }
  }
}
